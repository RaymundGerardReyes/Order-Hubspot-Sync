{
    "name": "order-hubspot-sync/backend",
    "type": "project",
    "description": "Order to HubSpot Sync Backend Service",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0|^2.0",
        "pestphp/pest-plugin-laravel": "^3.0|^2.0",
        "phpunit/phpunit": "^11.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php artisan test",
        "test:unit": "php artisan test --testsuite=Unit",
        "test:integration": "php artisan test --testsuite=Integration",
        "test:e2e": "HUBSPOT_E2E=1 php artisan test --testsuite=E2E",
        "test:regression": "php artisan test --testsuite=Regression"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
