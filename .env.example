# Node.js / TypeScript Integration API (Requirements 22–27)
PORT=3001
DATABASE_URL=file:./data/order-sync.sqlite
WEBHOOK_SECRET=replace-with-a-long-random-secret

# HubSpot CRM API Configuration
HUBSPOT_ACCESS_TOKEN=pat-na1-replace-with-scoped-token
HUBSPOT_PIPELINE_ID=replace-with-internal-pipeline-id
HUBSPOT_DEAL_STAGE_ID=replace-with-internal-stage-id
HUBSPOT_ORDER_ID_PROPERTY=external_order_id
HUBSPOT_REQUEST_TIMEOUT_MS=10000
HUBSPOT_MAX_ATTEMPTS=4

# Next.js Web Dashboard (Requirement 27)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Standalone PHP Exporter (Requirement 28 - Language B)
# Reads HUBSPOT_ACCESS_TOKEN from above automatically
